[Unit]
Description=XIAR authenticated Agent lifecycle and native prefix facade
After=network.target
[Service]
ExecStart=/usr/bin/python3 /opt/xiar/agent-control/server.py
Environment=PYTHONPATH=/opt/xiar/agent-control/python
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=LD_PRELOAD=@SQLITE@
User=root
Group=root
UMask=0077
Restart=on-failure
RestartSec=3
[Install]
WantedBy=multi-user.target
