# systemd --user unit. Outside Hermes; system python3, stdlib only. @REPO@ = the project checkout (for example ~/xiar-os).
[Unit]
Description=XIAR Reflex loop (config/loops.toml): fast, no LLM, state-change only
# (no After=default.target: the unit is WantedBy=default.target, so that ordering was a startup loop)
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Environment=XIAR_LOOPS_CONFIG=@REPO@/config/loops.toml
ExecStart=/usr/bin/python3 -I -B @REPO@/integrations/loops/xiar_loops.py reflex
Restart=always
RestartSec=15
Nice=15
CPUQuota=10%
MemoryMax=64M
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
