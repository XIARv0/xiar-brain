[Unit]
Description=XIAR circadian loop (one run)

[Service]
Type=oneshot
Environment=XIAR_LOOPS_CONFIG=@REPO@/config/loops.toml
ExecStart=/usr/bin/python3 -I -B @REPO@/integrations/loops/xiar_loops.py circadian
Nice=15
CPUQuota=20%
MemoryMax=128M
NoNewPrivileges=yes
PrivateTmp=yes
