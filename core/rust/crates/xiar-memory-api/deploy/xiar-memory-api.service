[Unit]
Description=XIAR tenant-scoped MIRIX memory API (localhost)
After=network.target

[Service]
Environment=XIAR_ROOT=%h/xiar-os
WorkingDirectory=%h/xiar-os
ExecStart=%h/xiar-os/core/rust/target/release/xiar-memory-api --config config/memory_api.toml serve
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target